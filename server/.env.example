# ShareBite AI — server environment
# Local dev works with defaults (nothing required). Production: set these.
PORT=4000
# DB_PATH=./sharebite.db          # SQLite file (node:sqlite + WAL). Point at a persistent volume in prod, e.g. /data/sharebite.db
# CLIENT_URL=https://your-frontend-domain   # only for SPLIT hosting (frontend on Vercel/Netlify). Comma-separated allowed. Same-server deploy: leave unset.
# TWILIO_ACCOUNT_SID=   # wire into src/notify.js for real WhatsApp
# TWILIO_AUTH_TOKEN=
